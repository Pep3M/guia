# ─── Base de datos ───────────────────────────────────────────────────────────
# Necesita PostgreSQL con la extensión pgvector.
DATABASE_URL="postgresql://guia:cambia-esta-clave@localhost:5432/guia"

# Sólo para docker compose:
POSTGRES_USER=guia
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=guia
APP_PORT=3000

# ─── Autenticación ───────────────────────────────────────────────────────────
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-largo"
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth con Google (opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Modelos ─────────────────────────────────────────────────────────────────
# Cualquier servidor con API compatible con OpenAI: Ollama, vLLM, LM Studio,
# llama.cpp o la propia OpenAI. Sin AI_BASE_URL se usa api.openai.com.
AI_BASE_URL="http://localhost:11434/v1"
AI_API_KEY="not-needed"

# Autohospedado (por defecto en docker compose).
# guia-chat es la variante que crea docker/ollama/bootstrap.sh a partir del
# modelo base, con la ventana de contexto ampliada.
CHAT_MODEL="guia-chat"
OLLAMA_BASE_MODEL="qwen2.5:14b-instruct"
EMBEDDING_MODEL="bge-m3"
EMBEDDING_DIMENSIONS=1024

# Fragmentos por petición de embeddings. Bájalo a 1 si tu servidor local no
# acepta lotes en /v1/embeddings.
EMBEDDING_BATCH_SIZE=32

# Fragmentos de documento inyectados como contexto en cada respuesta. Cada uno
# son unos 200 tokens: con ventanas de contexto pequeñas, bájalo.
RAG_MAX_CHUNKS=5

# Con OpenAI en su lugar:
# AI_BASE_URL=
# AI_API_KEY="sk-..."
# CHAT_MODEL="gpt-4o-mini"
# EMBEDDING_MODEL="text-embedding-3-small"
# EMBEDDING_DIMENSIONS=1536

# IMPORTANTE: EMBEDDING_DIMENSIONS debe coincidir con la dimensión declarada en
# la columna Chunk.embedding. Cambiar de modelo de embeddings obliga a migrar
# esa columna y a reindexar los documentos. Ver docs/self-hosting.md.

# ─── Almacenamiento de archivos ──────────────────────────────────────────────
# local        disco del servidor. Cero servicios extra, recomendado para
#              una sola máquina.
# s3           cualquier almacén compatible con S3: MinIO, Ceph, Garage,
#              Cloudflare R2, Backblaze B2 o AWS S3. Necesario si vas a
#              ejecutar varias réplicas de la aplicación.
# vercel-blob  sólo tiene sentido desplegando en Vercel.
STORAGE_DRIVER="local"
STORAGE_PATH="./storage"
MAX_UPLOAD_SIZE_MB=50

# Sólo si STORAGE_DRIVER=s3
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="guia"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="guia"
S3_SECRET_ACCESS_KEY="cambia-esta-clave"
# MinIO, Ceph y Garage usan rutas tipo host/bucket/clave; R2, B2 y AWS no.
S3_FORCE_PATH_STYLE=true
MINIO_CONSOLE_PORT=9001

# Sólo si STORAGE_DRIVER=vercel-blob
BLOB_READ_WRITE_TOKEN=""

# ─── Correo (invitaciones) ───────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Guía <no-reply@example.com>"

# ─── Demostración pública ────────────────────────────────────────────────────
# Con DEMO_MODE activo, la landing muestra un botón que entra en la organización
# de ejemplo. No hay autenticación especial: es un usuario con contraseña
# normal, publicada a propósito. Déjalo en false en una instalación real.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_EMAIL="demo@nordika.example"
NEXT_PUBLIC_DEMO_PASSWORD="demo1234"
NEXT_PUBLIC_DEMO_ORG_SLUG="nordika"
DEMO_ORG_SLUG="nordika"
DEMO_MEMBER_EMAIL="almacen@nordika.example"

# ─── Avatares ────────────────────────────────────────────────────────────────
AVATAR_UPLOAD_DAILY_LIMIT=3
AVATAR_MAX_SIZE_BYTES=2097152
NEXT_PUBLIC_AVATAR_MAX_SIZE_MB=2
NEXT_PUBLIC_AVATAR_MAX_DIMENSION=512
